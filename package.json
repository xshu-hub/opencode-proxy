{
  "name": "@xshu-hub/opencode-proxy",
  "version": "0.9.0",
  "type": "module",
  "description": "Magpie provider plugin through the real local OpenCode program",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE.txt",
    "docs/third-party-licenses.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "magpie",
    "opencode-plugin",
    "opencode",
    "provider"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/command.test.mjs test/reasoning.test.mjs test/catalog.test.mjs test/stream.test.mjs test/lifecycle.test.mjs test/hot-path.test.mjs test/compatibility.test.mjs test/dsml-tools.test.mjs test/shared.test.mjs test/magpie-plugin.test.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.mjs test/magpie-integration.test.mjs",
    "test:magpie-host": "node --test test/magpie-host.test.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xshu-hub/opencode-proxy.git"
  },
  "magpie": {
    "name": "Local OpenCode",
    "options": {
      "command": ["opencode"],
      "workerReuse": true,
      "maxIdleWorkers": 2
    }
  }
}
