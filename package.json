{
  "name": "@xshu-hub/opencode-proxy",
  "version": "0.10.0",
  "type": "module",
  "description": "Magpie provider plugin through the real local OpenCode program",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE.txt",
    "docs/third-party-licenses.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "magpie",
    "opencode-plugin",
    "opencode",
    "provider"
  ],
  "scripts": {
    "test": "node --test test/auth-fetch.test.mjs test/command.test.mjs test/catalog.test.mjs test/transport.test.mjs test/magpie-plugin.test.mjs",
    "check": "node scripts/check.mjs",
    "test:integration": "node --test --test-concurrency=1 test/transport-integration.test.mjs test/magpie-integration.test.mjs test/behavior-integration.test.mjs",
    "test:magpie-host": "node --test test/magpie-host.test.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.35"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xshu-hub/opencode-proxy.git"
  },
  "magpie": {
    "name": "Local OpenCode",
    "options": {
      "command": [
        "opencode"
      ],
      "startupTimeoutMs": 20000
    }
  },
  "dependencies": {
    "undici": "7.30.1"
  }
}
